{
  "name": "linux-ppl-container-build",
  "owner": "ci-composite Linux container packed library lane",
  "objective": "Build PPL via Linux Docker container path with deterministic evidence",
  "supported_bitness": [
    "64",
    "32"
  ],
  "default_bitness": "64",
  "required_preflight": [
    ".lvversion present",
    "Linux container image resolvable",
    "container parity lane enabled"
  ],
  "required_outputs": [
    "container build log evidence"
  ],
  "required_outputs_by_bitness": {
    "64": "lv_icon_x64.lvlibp or configured PPL artifact",
    "32": "lv_icon_x86.lvlibp or configured PPL artifact"
  },
  "failure_evidence": [
    "container logs",
    "artifact-missing status"
  ]
}
