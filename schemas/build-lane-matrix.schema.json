{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svelderrainruiz.github.io/lvie-codex-skills/schemas/build-lane-matrix.schema.json",
  "title": "Build Lane Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "lanes"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane_id",
          "display_name",
          "provider",
          "target_os",
          "bitness",
          "role",
          "required",
          "artifact_name",
          "metrics_category"
        ],
        "properties": {
          "lane_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "enum": [
              "selfhosted",
              "linux-container",
              "windows-container"
            ]
          },
          "target_os": {
            "type": "string",
            "enum": [
              "windows",
              "linux"
            ]
          },
          "bitness": {
            "type": "string",
            "enum": [
              "x64",
              "x86"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "required",
              "shadow"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "container_image": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_name": {
            "type": "string",
            "minLength": 1
          },
          "metrics_category": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "include_in_release_payload": {
            "type": "boolean"
          },
          "release_asset_name": {
            "type": "string",
            "minLength": 1
          },
          "release_asset_category": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
